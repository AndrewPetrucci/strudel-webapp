# Option A: separate vars (recommended)
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=strudel_webapp

# Option B: full URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strudel_webapp

PORT=3001

# Auth (required for sign in/sign up)
JWT_SECRET=your-secret-key-change-in-production

# Email (verification + password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# Origin for links in emails (built from protocol + host + port; Next.js dev is often port 3000)
APP_PROTOCOL=http
APP_HOST=localhost
APP_PORT=3000

